{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/manifest.schema.json",
  "title": "Reproducibility manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "created_at_utc",
    "git_commit",
    "config_sha256",
    "model_id",
    "model_revision",
    "dataset_sources",
    "seeds",
    "software"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_id": {"type": "string"},
    "model_revision": {"type": "string"},
    "dataset_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "uri", "sha256", "license"]
      }
    },
    "seeds": {"type": "array", "items": {"type": "integer"}},
    "software": {"type": "object"}
  }
}
